# Same Si SCF calculation as Si_scf.in, but written in PWTK (Tcl) syntax.
# Notice: namelists use { } instead of & ... /, and values can be math
# expressions (4*18.0, 1/4).
#
# Run:   pwtk Si_scf.pwtk

CONTROL {
  calculation = 'scf'
       prefix = 'Si'
       outdir = './tmp_pwtk/'
}

SYSTEM {
        ibrav = 2
    celldm(1) = 10.2
          nat = 2
         ntyp = 1
      ecutwfc = 18.0
      ecutrho = 4*18.0
}

ELECTRONS {
      conv_thr = 1d-7
}

ATOMIC_SPECIES {
   Si  28.086  Si.pz-vbc.UPF
}

ATOMIC_POSITIONS alat {
   Si    0.0   0.0   0.0
   Si    1/4   1/4   1/4
}

K_POINTS automatic {
   4 4 4   1 1 1
}

# PWTK writes pwtk.Si_scf.in, runs pw.x on it, and writes pwtk.Si_scf.out
runPW pwtk.Si_scf

# extract the total energy from the output (one line instead of grep)
print "Total energy (Ry) = [pwo_totene pwtk.Si_scf.out]"
